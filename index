    <!-- JavaScript Logic -->
    <script>
        // Global State & Local Storage Keys
        const STORAGE_CHECK_KEY = "gold_compound_checked_days";
        let checkedDays = JSON.parse(localStorage.getItem(STORAGE_CHECK_KEY)) || [];
        let growthChartInstance = null;
        let currentSimulationData = [];

        // DOM Elements
        const inputInitialBalance = document.getElementById('inputInitialBalance');
        const inputPhase1Rate = document.getElementById('inputPhase1Rate');
        const inputPhase2Rate = document.getElementById('inputPhase2Rate');
        const inputLotRatio = document.getElementById('inputLotRatio');
        
        const cardInitialBalance = document.getElementById('cardInitialBalance');
        const cardDay30Balance = document.getElementById('cardDay30Balance');
        const cardDay30Growth = document.getElementById('cardDay30Growth');
        const cardDay60Balance = document.getElementById('cardDay60Balance');
        const cardDay60Growth = document.getElementById('cardDay60Growth');

        const tableBody = document.getElementById('simulationTableBody');
        const tableSearch = document.getElementById('tableSearch');
        const phaseFilter = document.getElementById('phaseFilter');
        const completedCountText = document.getElementById('completedCountText');

        // Risk Calculator Elements
        const calcEquity = document.getElementById('calcEquity');
        const calcRiskPct = document.getElementById('calcRiskPct');
        const calcSLPips = document.getElementById('calcSLPips');
        const calcResultLot = document.getElementById('calcResultLot');
        const calcResultRiskUSD = document.getElementById('calcResultRiskUSD');

        // Format Currency Helper
        function formatUSD(amount) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
        }

        // Calculate Main Simulation Data
        function calculateSimulation() {
            const initialBalance = parseFloat(inputInitialBalance.value) || 100;
            const phase1Rate = (parseFloat(inputPhase1Rate.value) || 15) / 100;
            const phase2Rate = (parseFloat(inputPhase2Rate.value) || 5) / 100;
            const lotRatio = parseFloat(inputLotRatio.value) || 0.01;

            currentSimulationData = [];
            let currentBalance = initialBalance;

            for (let day = 1; day <= 60; day++) {
                const isPhase1 = day <= 30;
                const rate = isPhase1 ? phase1Rate : phase2Rate;
                const startBalance = currentBalance;
                const profitTarget = startBalance * rate;
                const endBalance = startBalance + profitTarget;
                
                // Recommended lot proportional to balance ($100 = lotRatio)
                const recommendedLot = Math.max(0.01, (startBalance / 100) * lotRatio);

                currentSimulationData.push({
                    day: day,
                    phase: isPhase1 ? 1 : 2,
                    ratePercent: isPhase1 ? (phase1Rate * 100) : (phase2Rate * 100),
                    startBalance: startBalance,
                    profitTarget: profitTarget,
                    endBalance: endBalance,
                    recommendedLot: recommendedLot
                });

                currentBalance = endBalance;
            }

            updateDashboardUI(initialBalance);
            renderTable();
            updateChart();
        }

        // Update Dashboard Summary Cards
        function updateDashboardUI(initialBalance) {
            const day30 = currentSimulationData[29];
            const day60 = currentSimulationData[59];

            cardInitialBalance.textContent = formatUSD(initialBalance);
            cardDay30Balance.textContent = formatUSD(day30.endBalance);
            cardDay60Balance.textContent = formatUSD(day60.endBalance);

            const growth30 = ((day30.endBalance - initialBalance) / initialBalance) * 100;
            const growth60 = ((day60.endBalance - initialBalance) / initialBalance) * 100;

            cardDay30Growth.textContent = `+${growth30.toLocaleString('en-US', {maximumFractionDigits: 0})}% Growth`;
            cardDay60Growth.textContent = `+${growth60.toLocaleString('en-US', {maximumFractionDigits: 0})}% Growth`;

            // Auto sync Quick Calculator Equity with Day 1 initial balance if user hasn't typed custom
            calcEquity.value = initialBalance;
            calculateQuickRisk();
        }

        // Render Daily Simulation Table
        function renderTable() {
            const searchTerm = tableSearch.value.toLowerCase().trim();
            const filterValue = phaseFilter.value;

            tableBody.innerHTML = '';
            let completedCount = 0;

            currentSimulationData.forEach(item => {
                const isChecked = checkedDays.includes(item.day);
                if (isChecked) completedCount++;

                // Filter logic
                if (filterValue === 'phase1' && item.phase !== 1) return;
                if (filterValue === 'phase2' && item.phase !== 2) return;
                if (searchTerm && !`hari ${item.day}`.includes(searchTerm) && !`${item.day}`.includes(searchTerm)) return;

                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-800/50 transition ${isChecked ? 'bg-amber-500/10' : ''}`;

                tr.innerHTML = `
                    <td class="px-4 py-3 text-center">
                        <input type="checkbox" onchange="toggleDayCheck(${item.day})" ${isChecked ? 'checked' : ''}
                            class="w-4 h-4 text-gold-500 bg-slate-900 border-slate-700 rounded focus:ring-amber-500 accent-amber-500 cursor-pointer">
                    </td>
                    <td class="px-4 py-3 font-semibold ${isChecked ? 'text-amber-400' : 'text-white'}">Hari ${item.day}</td>
                    <td class="px-4 py-3">
                        <span class="px-2 py-0.5 text-[10px] rounded-md font-semibold ${item.phase === 1 ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}">
                            Fase ${item.phase} (${item.ratePercent}%)
                        </span>
                    </td>
                    <td class="px-4 py-3 text-slate-300">${formatUSD(item.startBalance)}</td>
                    <td class="px-4 py-3 text-emerald-400 font-semibold">+${formatUSD(item.profitTarget)}</td>
                    <td class="px-4 py-3 text-white font-bold">${formatUSD(item.endBalance)}</td>
                    <td class="px-4 py-3 text-center font-bold text-amber-400">${item.recommendedLot.toFixed(2)} Lot</td>
                `;

                tableBody.appendChild(tr);
            });

            completedCountText.textContent = `Progres: ${completedCount} / 60 Hari Tercapai (${((completedCount/60)*100).toFixed(0)}%)`;
        }

        // Toggle Day Checklist State
        function toggleDayCheck(day) {
            if (checkedDays.includes(day)) {
                checkedDays = checkedDays.filter(d => d !== day);
            } else {
                checkedDays.push(day);
            }
            localStorage.setItem(STORAGE_CHECK_KEY, JSON.stringify(checkedDays));
            renderTable();
        }

        // Reset Data
        function resetData() {
            if (confirm("Apakah Anda yakin ingin mereset checklist harian dan pengisian parameter ke default?")) {
                localStorage.removeItem(STORAGE_CHECK_KEY);
                checkedDays = [];
                inputInitialBalance.value = 100;
                inputPhase1Rate.value = 15;
                inputPhase2Rate.value = 5;
                inputLotRatio.value = 0.01;
                calculateSimulation();
            }
        }

        // Quick Risk & Lot Calculator Function
        function calculateQuickRisk() {
            const equity = parseFloat(calcEquity.value) || 0;
            const riskPct = parseFloat(calcRiskPct.value) || 0;
            const slPips = parseFloat(calcSLPips.value) || 1;

            const riskUSD = equity * (riskPct / 100);
            
            // XAUUSD: 1 Pip = $0.10 for 0.01 Lot (or $10 per pip for 1.00 standard lot)
            // Pip Value = Lot * 10
            // RiskUSD = SLPips * Lot * 10  => Lot = RiskUSD / (SLPips * 10)
            let calculatedLot = riskUSD / (slPips * 10);
            if (calculatedLot < 0.01) calculatedLot = 0.01;

            calcResultLot.textContent = `${calculatedLot.toFixed(2)} Lot`;
            calcResultRiskUSD.textContent = `Risk: ${formatUSD(riskUSD)}`;
        }

        // Chart Render Function
        function updateChart() {
            const ctx = document.getElementById('growthChart').getContext('2d');
            const labels = currentSimulationData.map(d => `H-${d.day}`);
            const dataValues = currentSimulationData.map(d => d.endBalance);

            if (growthChartInstance) {
                growthChartInstance.destroy();
            }

            growthChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Saldo ($)',
                        data: dataValues,
                        borderColor: '#F59E0B',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 0,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function(context) {
                                    return ` Saldo: $${context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: { color: '#64748B', font: { size: 10 }, maxTicksLimit: 12 }
                        },
                        y: {
                            grid: { color: 'rgba(51, 65, 85, 0.4)', drawBorder: false },
                            ticks: { 
                                color: '#64748B', 
                                font: { size: 10 },
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        // Event Listeners
        tableSearch.addEventListener('input', renderTable);
        phaseFilter.addEventListener('change', renderTable);

        calcEquity.addEventListener('input', calculateQuickRisk);
        calcRiskPct.addEventListener('input', calculateQuickRisk);
        calcSLPips.addEventListener('input', calculateQuickRisk);

        // Initial Initialization on Window Load
        window.onload = function() {
            calculateSimulation();
        };
    </script>
</body>
</html>
